#!/bin/bash
set -euo pipefail
[[ -n "${TMPCONFIG_DEBUG:=}" ]] && set -x
DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "${XDG_RUNTIME_DIR:=/tmp}/spack-tests"
export TMPDIR="${XDG_RUNTIME_DIR}"
export TMP_DIR="$(mktemp -d -t spack-test-XXXXX)"
clean_up() {
    [[ -n "$TMPCONFIG_DEBUG" ]] && printf "cleaning up: $TMP_DIR\n"
    rm -rf "$TMP_DIR"
}
trap clean_up EXIT
trap clean_up ERR

[[ -n "$TMPCONFIG_DEBUG" ]] && printf "Redirecting TMP_DIR and spack directories to $TMP_DIR\n"

export BOOTSTRAP="$($DIR/spack bootstrap root)"
private_bootstrap="$TMP_DIR/bootstrap"

use_spack=''
use_bwrap=''
# argument handling
while (($# >= 1)) ; do
    case "$1" in
        -b) # privatize bootstrap too, useful for CI but not always cheap
            shift
            export BOOTSTRAP="$private_bootstrap"
            ;;
        -B) # use specified bootstrap dir
            export BOOTSTRAP="$2"
            shift 2
            ;;
        -s) # run spack directly with remaining args
            shift
            use_spack=1
            ;;
        --contain=bwrap)
            if bwrap --help 2>&1 > /dev/null ; then
                use_bwrap=1
            else
                echo Bubblewrap containment requested, but no bwrap command found
                exit 1
            fi
            shift
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done
typeset -a CMD
if [[ -n "$use_spack" ]] ; then
    CMD=("$DIR/spack" "$@")
else
    CMD=("$@")
fi

mkdir -p "$BOOTSTRAP"

export SPACK_SYSTEM_CONFIG_PATH="$TMP_DIR/sys_conf"
export SPACK_USER_CONFIG_PATH="$TMP_DIR/user_conf"
# SPACK_CONFIG_HOME takes precedence over SPACK_USER_CONFIG_PATH for the user scope and
# would also keep home migration from being skipped; point it at the same directory.
export SPACK_CONFIG_HOME="$SPACK_USER_CONFIG_PATH"
mkdir -p "$SPACK_USER_CONFIG_PATH"
# We redirect the default locations and we explicitly redirect the individual entries
# This ensures new locations are moved by default, and specific entries are moved even
# if the user has overridden them.
cat >"$SPACK_USER_CONFIG_PATH/config.yaml" <<EOF
config:
  locations:
    data: $TMP_DIR/data
    state: $TMP_DIR/state
    cache: $TMP_DIR/cache
  install_tree:
    root: \$data_home/install
  misc_cache: \$cache_home/cache
  source_cache: \$data_home/source
  environments_root: \$data_home/envs
EOF
# Bootstrap is redirected back to the original location unless using `-b/-B`.
cat >"$SPACK_USER_CONFIG_PATH/bootstrap.yaml" <<EOF
bootstrap:
  root: $BOOTSTRAP
EOF

# ro bindings are belt+suspenders in case the config above doesn't redirect everything
if [[ -n "$use_bwrap" ]] ; then
    CMD=(
        bwrap
        --dev-bind / /
        --ro-bind "$DIR/.." "$DIR/.." # do not touch spack root
        --ro-bind-try $HOME/.config/spack $HOME/.config/spack # do not touch user config dir
        --ro-bind-try $HOME/.cache/spack $HOME/.cache/spack # do not touch user cache dir
        --ro-bind-try $HOME/.local/state/spack $HOME/.local/state/spack # do not touch user state dir
        --ro-bind-try $HOME/.local/share/spack $HOME/.local/share/spack # do not touch user data dir
        --bind "$TMP_DIR" "$TMP_DIR"
        --bind "$BOOTSTRAP" "$BOOTSTRAP"
        --die-with-parent
        "${CMD[@]}"
    )
fi

(( ${TMPCONFIG_DEBUG:=0} > 1)) && echo "Running: ${CMD[@]}"
"${CMD[@]}"
